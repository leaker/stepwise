{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stepwise",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/demo/*"]
  },
  "browser": { "binding": "BROWSER" },
  "d1_databases": [
    { "binding": "DB", "database_name": "stepwise", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [{ "binding": "SHOTS", "bucket_name": "stepwise-screenshots" }],
  "queues": {
    "producers": [{ "binding": "RUN_QUEUE", "queue": "stepwise-runs" }],
    "consumers": [{ "queue": "stepwise-runs", "max_batch_size": 1, "max_retries": 0 }]
  },
  "observability": { "enabled": true }
}
