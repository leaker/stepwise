{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stepwise",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [{ "pattern": "stepwise.keworks.dev", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // /assets/* goes through the Worker so that a missing hashed file is a 404, not the app shell cached as
    // immutable under a script's address (see worker/index.ts).
    "run_worker_first": ["/api/*", "/demo/*", "/assets/*"]
  },
  "browser": { "binding": "BROWSER" },
  "d1_databases": [
    { "binding": "DB", "database_name": "stepwise", "database_id": "95974136-5029-4a3d-a0b0-a10838c406d5", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [{ "binding": "SHOTS", "bucket_name": "stepwise-screenshots" }],
  "queues": {
    "producers": [{ "binding": "RUN_QUEUE", "queue": "stepwise-runs" }],
    // A message is retried only when no browser could be started (see handleQueue). max_concurrency stays
    // below the account's concurrent browser limit so a capture can still get a session.
    "consumers": [{ "queue": "stepwise-runs", "max_batch_size": 1, "max_retries": 3, "max_concurrency": 2 }]
  },
  // Counts wrong access codes per client address (worker/auth.ts): after 10 in a minute the address is not
  // listened to for a minute. namespace_id is any number that no other limiter of the account uses.
  "ratelimits": [{ "name": "ACCESS_LIMITER", "namespace_id": "4101", "simple": { "limit": 10, "period": 60 } }],
  "vars": {
    // The Claude model the AI assistant asks: claude-haiku-5-5, claude-sonnet-5-5 or claude-opus-5-5
    // (worker/assistant/models.ts). Haiku is the cheapest one that passed every run of the benchmark
    // (scripts/bench-assistant.mjs; results in the README).
    "ASSISTANT_MODEL": "claude-haiku-5-5",
    // The assistant's estimated spend limit in USD for the whole deployment per 24 hours. The number of
    // sessions per 24 hours can be set too: ASSISTANT_DAILY_SESSIONS (default "100").
    "ASSISTANT_DAILY_BUDGET_USD": "40"
    // Optional: restrict which sites captures and navigate steps may open (the app's own origin is always allowed).
    // "ALLOWED_HOSTS": "example.com,staging.example.com"
  },
  // Optional: `wrangler secret put ACCESS_CODE` to require an access code for the whole API.
  // Optional: `wrangler secret put ANTHROPIC_API_KEY` to enable the AI assistant in the editor.
  "observability": { "enabled": true }
}
