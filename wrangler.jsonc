{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stepwise",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [{ "pattern": "stepwise.keworks.dev", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/demo/*"]
  },
  "browser": { "binding": "BROWSER" },
  "d1_databases": [
    { "binding": "DB", "database_name": "stepwise", "database_id": "95974136-5029-4a3d-a0b0-a10838c406d5", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [{ "binding": "SHOTS", "bucket_name": "stepwise-screenshots" }],
  "queues": {
    "producers": [{ "binding": "RUN_QUEUE", "queue": "stepwise-runs" }],
    // A message is retried only when no browser could be started (see handleQueue). max_concurrency stays
    // below the account's concurrent browser limit so a capture can still get a session.
    "consumers": [{ "queue": "stepwise-runs", "max_batch_size": 1, "max_retries": 3, "max_concurrency": 2 }]
  },
  // Optional: restrict which sites captures and navigate steps may open (the app's own origin is always allowed).
  // "vars": { "ALLOWED_HOSTS": "example.com,staging.example.com" },
  // Optional: `wrangler secret put ACCESS_CODE` to require an access code for the whole API.
  // Optional: `wrangler secret put ANTHROPIC_API_KEY` to enable the AI assistant in the editor. Its budget per
  // 24 hours can be set under "vars": ASSISTANT_DAILY_SESSIONS (default "100"), ASSISTANT_DAILY_BUDGET_USD ("20").
  "observability": { "enabled": true }
}
